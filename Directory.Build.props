<Project>

  <!-- Shared by every project. Settings that decide what the compiler will accept live here so they cannot
       drift apart between the library, the app and the tests. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning is a defect that has not bitten yet. Four of them sat in this build for months, and one
         was a guard that had quietly stopped guarding anything. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- ...except the package audit. Those appear when someone publishes an advisory, not when someone
         writes code, so they must be loud without being able to stop a build that nobody changed. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- The app ships as a single file, where Assembly.Location and friends quietly return nothing useful.
         The code avoids them today; this is what keeps it that way. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
