<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cascade.Core\Cascade.Core.csproj" />
  </ItemGroup>

  <!-- The checks that drive real controls, dialogs and windows live in this project's test assembly.
       They used to live in the app itself, behind a "selftest" switch, and were about a third of the
       managed payload of every release. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cascade.AppTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\cascade.ico" />
    <EmbeddedResource Include="Assets\eye-off.png" />
    <EmbeddedResource Include="Assets\lucide-LICENSE.txt" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\cascade.ico</ApplicationIcon>
    <AssemblyName>Cascade</AssemblyName>
    <RootNamespace>Cascade.App</RootNamespace>
    <!-- PublishSingleFile with a runtime identifier defaults to a self-contained publish, and some SDKs ignore the false self-contained CLI switch, so the framework-dependent shape is declared here where MSBuild is authoritative. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>